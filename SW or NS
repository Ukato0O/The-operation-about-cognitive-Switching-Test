#Setting
    install.packages(dplyr)
    install.packages(forcats)
    install.packages(tidyr)
    install.packages(openxlsx)
    
    library(dplyr)
    library(forcats)
    library(tidyr)
    library(openxlsx)
#Main
    data = read.table(file.choose(), header = T, sep = ",")
    dta = data |> dplyr::select(ExperimentName, Subject, Age, Sex, Picture, Key, Key2, Procedure, Running, TaskSti.ACC, TaskSti.RT)
    dta$Sex = factor(dta$Sex, levels = c("男性", "女性"))
    dta$Key = factor(dta$Key, levels = c("NSBlock", "Mixed"))
    
    #tmp為資料操作檔案
    tmp = dta |> dplyr::mutate(Key2 = ifelse(grepl("Mono", Key2), "NS", Key2)) 
    tmp$Key2 = factor(tmp$Key2, levels = c("NS", "SW"))
    tmp = tmp |> dplyr::mutate(Picture = ifelse(grepl("red", Picture), "red", Picture))
    tmp = tmp |> dplyr::mutate(Picture = ifelse(grepl("green", Picture), "green", Picture))
    tmp$Picture = factor(tmp$Picture)
    #消除Prac資料
    tmp = tmp |> dplyr::filter(Procedure == "Switching")
    #先處理計算ACC，RT會再洗資料
    account = tmp |> dplyr::group_by(ExperimentName, Subject, Age, Sex, Key) |>
                     summarise(ACC = mean(TaskSti.ACC), .groups = "drop") |>
                     tidyr::pivot_wider(names_from = Key, values_from = ACC) |>
                     rename("ACC_Mono" = "NSBlock", "ACC_Mix" = "Mixed")
    #ACC資料合併
    ACC = bind_rows(get0("ACC"), account)
    
    
    #以下為RT計算的必要資料處理，ACC已經可直接計算
    #以1紀錄各類狀態的第一題，附帶簡查Prac資料是否有消除
    tmp = tmp |> dplyr::mutate(Key3 = ifelse(Running != lag(Running, default = "Prac"), 1, as.character(Running)))
    tmp1 = tmp |> dplyr::filter(TaskSti.RT > 200 & TaskSti.RT <= 2000) |>
                  dplyr::filter(TaskSti.ACC == 1) |>
                  dplyr::filter(Key3 != 1)
    rtcount = tmp1 |> dplyr::group_by(ExperimentName, Subject, Age, Sex, Key) |>
                      summarise(RT = mean(TaskSti.RT), .groups = "drop") |>
                      tidyr::pivot_wider(names_from = Key, values_from = RT) |>
                      rename("RT_Mono" = "NSBlock", "RT_Mix" = "Mixed")
    #RT資料合併
    RT = bind_rows(get0("RT"), rtcount)
    #總資料彙整
    dataset = rbind(get0("dataset"), tmp)
    ###到此重複對所有csv檔執行###
    
    write.xlsx(ACC, file.choose(), colnames = T)
    write.xlsx(RT, file.choose(), colnames = T)
